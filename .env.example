# GitCode web account credentials used only when no access token is available.
# Hyphenated keys are accepted too: gitcode-account / gitcode-password.
GITCODE_ACCOUNT=
GITCODE_PASSWORD=

# A GitCode web OAuth access token is preferred over account/password login.
# Do not use a GitCode classic PAT here; CANNLab expects the web token.
CANNLAB_ACCESS_TOKEN=
CANNLAB_REFRESH_TOKEN=

# Optional overrides.
CANNLAB_API_BASE=https://web-api.gitcode.com/score-proxy/api/v1/shop/third-party
CANNLAB_AUTH_FILE=
CANNLAB_TIMEOUT_SECONDS=1800
CANNLAB_POLL_INTERVAL_SECONDS=5
# Set only for an explicitly authorized live lifecycle test.
CANNLAB_ALLOW_LIVE_MUTATIONS=0
